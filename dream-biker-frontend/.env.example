# Copy to .env.local and fill in. Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix except the site URL, so secrets stay server-side.

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
# Either a channel ID (UC...) or a handle. The ID wins if both are set.
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=@DreamBiker532

# --- Facebook Graph API ---
FACEBOOK_PAGE_ID=BuydreambyHanif
# Long-lived Page Access Token (FACEBOOK_ACCESS_TOKEN is also accepted as an alias)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v22.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Sync endpoint protection ---
# Required for /api/admin/social/* and /api/social/*/sync. Minimum 16 characters.
# If neither secret is set, those endpoints reject every request.
SYNC_SECRET_KEY=
# Set in Vercel so the scheduled sync in vercel.json is authorized (Vercel sends it as a Bearer token).
CRON_SECRET=

# --- Database (optional but recommended in production) ---
# Without it, synced data and contact messages live only in one server instance's memory
# and are lost on restart; on Vercel the contact form cannot accept messages at all.
DATABASE_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
