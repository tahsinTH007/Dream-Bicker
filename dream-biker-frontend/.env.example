# ==============================================================================
# DREAM BIKER — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YOUTUBE DATA API V3
# Obtain from Google Cloud Console: https://console.cloud.google.com/
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UCr_x_your_channel_id_here
# Used only when YOUTUBE_CHANNEL_ID is empty
YOUTUBE_CHANNEL_HANDLE=@DreamBiker532
YOUTUBE_API_ENABLED=true

# ------------------------------------------------------------------------------
# 2. FACEBOOK GRAPH API (META FOR DEVELOPERS)
# Obtain from Meta for Developers: https://developers.facebook.com/
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=your_meta_app_id_here
FACEBOOK_APP_SECRET=your_meta_app_secret_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token_here
# Optional, temporary: a user token from Graph API Explorer. `npm run facebook:token`
# turns it into a long-lived page token, saves it above and removes this line.
# FACEBOOK_APP_ID / FACEBOOK_APP_SECRET must be those of the app that issued it.
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v22.0
FACEBOOK_API_ENABLED=true

# ------------------------------------------------------------------------------
# 3. SYNCHRONIZATION & SECURITY
# Secret key required to authorize manual and cron-scheduled synchronizations
# (minimum 16 characters; if unset, the sync endpoints reject every request)
# ------------------------------------------------------------------------------
SYNC_SECRET_KEY=dream_biker_secret_key_change_in_production
# Set on Vercel: the scheduled sync in vercel.json authenticates with this value
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4. APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. OPTIONAL PERSISTENT DATABASE (POSTGRESQL WITH PRISMA)
# Leave blank to use optimized local/cached fallback storage in development
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/dreambiker?schema=public

# ------------------------------------------------------------------------------
# 6. SOCIAL CONTENT SYNCHRONIZATION SETTINGS
# ------------------------------------------------------------------------------
SOCIAL_SYNC_ENABLED=true
SOCIAL_SYNC_INTERVAL_MINUTES=30
SOCIAL_SYNC_INITIAL_LOOKBACK_DAYS=365
